---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <template id="bookmark-template">
    <li class="bookmark">
      <a class="url" target="_blank" rel="noopener noreferrer"></a>
      <button type="button" class="copy">Copy slug</button>
    </li>
  </template>
</ul>

<script>
  import {
    STORAGE_KEY,
    formatBookmark,
    generateSlug,
    normalizeUrl,
    parseBookmarks,
    type Bookmark,
  } from './bookmarks';

  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const input = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const template = document.querySelector<HTMLTemplateElement>('#bookmark-template');
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  const listHeader = document.querySelector<HTMLElement>('#list-header');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-all');

  function loadBookmarks(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  let bookmarks = loadBookmarks();

  function persistBookmarks(): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch (error) {
      console.error('Unable to save bookmarks.', error);
    }
  }

  function renderBookmarks(): void {
    if (!list || !template || !emptyState || !listHeader) {
      return;
    }

    list.querySelectorAll('.bookmark').forEach((item) => item.remove());

    for (const bookmark of bookmarks) {
      const row = template.content.cloneNode(true) as DocumentFragment;
      const link = row.querySelector<HTMLAnchorElement>('.url');
      const copyButton = row.querySelector<HTMLButtonElement>('.copy');

      if (!link || !copyButton) {
        continue;
      }

      link.href = bookmark.url;
      link.textContent = formatBookmark(bookmark);
      copyButton.dataset.slug = bookmark.slug;
      list.append(row);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!input) {
      return;
    }

    try {
      const url = normalizeUrl(input.value);
      let slug = generateSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        slug = generateSlug();
      }

      bookmarks = [...bookmarks, { url, slug }];
      persistBookmarks();
      renderBookmarks();
      form.reset();
      input.focus();
    } catch (error) {
      input.setCustomValidity(error instanceof Error ? error.message : 'Enter a valid URL.');
      input.reportValidity();
    }
  });

  input?.addEventListener('input', () => input.setCustomValidity(''));

  list?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.matches('.copy')) {
      return;
    }

    const slug = target.dataset.slug;
    if (!slug) {
      return;
    }

    try {
      await navigator.clipboard.writeText(slug);
      target.textContent = 'Copied!';
      window.setTimeout(() => {
        target.textContent = 'Copy slug';
      }, 1200);
    } catch (error) {
      console.error('Unable to copy the bookmark slug.', error);
    }
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) {
      return;
    }

    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch (error) {
      console.error('Unable to clear saved bookmarks.', error);
    }
    renderBookmarks();
  });

  renderBookmarks();
</script>
